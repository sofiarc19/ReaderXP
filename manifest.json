{
  "manifest_version": 3,
  "name": "ReaderXP",
  "version": "1.0",
  "description": "ReaderXP analyzes webpage text to create a focused reading experience.",

  "action": {
    "default_popup": "popup/popup.html"
  },

  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "*://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}