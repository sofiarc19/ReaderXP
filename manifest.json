{
  "manifest_version": 3,
  "name": "ReaderXP (Alpha)",
  "version": "0.1",
  "description": "Enhancing Reading Engagement through Accessibility, Personalization, and Gamification",

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "popup/assets/icon/Excited.png"
  },
  "icons": {
    "128": "popup/assets/icon/ReaderXP-Icon2.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "*://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
